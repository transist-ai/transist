{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["command"],
  "properties": {
    "command": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repo_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["command"], "properties": { "command": { "pattern": "repo://" } } },
          { "required": ["args"], "properties": { "args": { "contains": { "type": "string", "pattern": "repo://" } } } }
        ]
      },
      "then": { "required": ["repo_path"] }
    }
  ],
  "additionalProperties": true
}
