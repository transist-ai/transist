{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["command"],
  "properties": {
    "command": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": ["string", "number", "boolean"] }
    },
    "gate_decision": {
      "type": "object",
      "required": ["schema", "run_id", "gate_id", "step_id", "decision", "decided_at_ms"],
      "properties": {
        "schema": { "const": "transist.gate_decision.v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "gate_id": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "rejected", "request_changes"] },
        "actor": { "type": "string" },
        "actor_source": { "type": "string" },
        "reason": { "type": "string" },
        "decided_at_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "repo_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["command"], "properties": { "command": { "pattern": "repo://" } } },
          { "required": ["args"], "properties": { "args": { "contains": { "type": "string", "pattern": "repo://" } } } }
        ]
      },
      "then": { "required": ["repo_path"] }
    }
  ],
  "additionalProperties": true
}
