# SPDX-License-Identifier: MPL-2.0
# CI executable versions and immutable download digests. Keep each tool here once.

CARGO_DENY_VERSION=0.20.2
CARGO_ABOUT_VERSION=0.9.1
CARGO_CYCLONEDX_VERSION=0.5.9
CARGO_LLVM_COV_VERSION=0.9.0
LYCHEE_VERSION=0.20.1
LYCHEE_LINUX_X64_SHA256=1dd08bb064e2114c2c9d0c9009f51577de24e805361d6332162807972d8e9474
# Python jsonschema used to semantically validate CycloneDX SBOM documents
# (scripts/ci/normalize_and_validate_sbom.py). Pinned so SBOM validation bytes
# and behaviour are deterministic across environments.
PY_JSONSCHEMA_VERSION=4.23.0

GITLEAKS_VERSION=8.30.1
GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_MACOS_ARM64_SHA256=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5

RIPGREP_VERSION=15.2.0
RIPGREP_LINUX_X64_SHA256=33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c
RIPGREP_MACOS_ARM64_SHA256=3750b2e93f37e0c692657da574d7019a101c0084da05a790c83fd335bad973e4

ACTIONLINT_VERSION=1.7.12
ACTIONLINT_LINUX_X64_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_MACOS_ARM64_SHA256=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f

MINISIGN_VERSION=0.12
MINISIGN_LINUX_X64_SHA256=9a599b48ba6eb7b1e80f12f36b94ceca7c00b7a5173c95c3efc88d9822957e73
MINISIGN_MACOS_ARM64_SHA256=89000b19535765f9cffc65a65d64a820f433ef6db8020667f7570e06bf6aac63

GH_VERSION=2.97.0
GH_LINUX_X64_SHA256=a2c9b8497e1f85b1ad0dfcb78b5a622e098801b8e461e459e88e1ee12f018112
GH_MACOS_ARM64_SHA256=a58b8fd77b417a38f47a0b54d1370c59b0fcdb324ccc9ca002b0998f7c4c999e

# Semantic OpenAPI validator. Installed from the committed lockfile
# (scripts/ci/redocly/package-lock.json); the lockfile is the integrity source.
REDOCLY_CLI_VERSION=2.76.0
# Maintained library; the JSONC/glob runner avoids CLI2's unpatched braces tree.
MARKDOWNLINT_VERSION=0.42.0

# Official Node release checksums: https://nodejs.org/dist/v22.22.0/SHASUMS256.txt
# Bundle npm with the runtime; Bookworm's apt Node 18 cannot run these CI CLIs.
NODE_VERSION=22.22.0
NODE_LINUX_X64_URL=https://nodejs.org/dist/v22.22.0/node-v22.22.0-linux-x64.tar.gz
NODE_LINUX_X64_SHA256=c33c39ed9c80deddde77c960d00119918b9e352426fd604ba41638d6526a4744
NODE_MACOS_ARM64_SHA256=5ed4db0fcf1eaf84d91ad12462631d73bf4576c1377e192d222e48026a902640

CI_CONTAINER_IMAGE=rust:1.88.0-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0
CI_ALPINE_CONTAINER_IMAGE=rust:1.88.0-alpine@sha256:9dfaae478ecd298b6b5a039e1f2cc4fc040fc818a2de9aa78fa714dea036574d
LINUX_RUNNER_IMAGE=ubuntu-24.04
MACOS_RUNNER_IMAGE=macos-15
LINUX_ARM_RUNNER_IMAGE=ubuntu-24.04-arm
MACOS_INTEL_RUNNER_IMAGE=macos-15-intel

# Debian (bookworm) system/CI tooling installed with apt-get inside the
# digest-pinned CI_CONTAINER_IMAGE container. Each value is an apt-get
# `<package>=<exact version>` pin so the installed tool set is deterministic
# and cannot drift onto an un-versioned package. Kept in tool-versions.env so
# the supply-chain pin checker (check_supply_chain_pins.sh) can verify workflow
# installs against these values and so installs stay single-sourced.
APT_CURL_PACKAGE=curl=7.88.1-10+deb12u15
APT_UNZIP_PACKAGE=unzip=6.0-28
APT_NODEJS_PACKAGE=nodejs=18.20.4+dfsg-1~deb12u3
APT_NPM_PACKAGE=npm=9.2.0~ds1-1
APT_BUBBLEWRAP_PACKAGE=bubblewrap=0.8.0-2+deb12u1
APT_RIPGREP_PACKAGE=ripgrep=13.0.0-4+b2
APT_GIT_PACKAGE=git=1:2.39.5-0+deb12u3
APT_JQ_PACKAGE=jq=1.6-2.1+deb12u3
APT_PYTHON3_PACKAGE=python3=3.11.2-1+b1
APT_PYTHON3_PIP_PACKAGE=python3-pip=23.0.1+dfsg-1
APT_MUSL_TOOLS_PACKAGE=musl-tools=1.2.3-1

# Alpine (musl) environment. Every runtime/build package is installed from a
# pinned main/community version within the digest-pinned CI_ALPINE_CONTAINER_IMAGE
# container above; the package version pin keeps the Alpine build and sandbox
# environment deterministic.
ALPINE_BASH_PACKAGE=bash=5.2.37-r0
ALPINE_GIT_PACKAGE=git=2.49.1-r0
ALPINE_TAR_PACKAGE=tar=1.35-r3
ALPINE_MUSL_DEV_PACKAGE=musl-dev=1.2.5-r13
ALPINE_FILE_PACKAGE=file=5.46-r2
ALPINE_JQ_PACKAGE=jq=1.8.2-r0
ALPINE_PYTHON3_PACKAGE=python3=3.12.16-r0
ALPINE_PY3_PIP_PACKAGE=py3-pip=25.1.1-r0
ALPINE_BUBBLEWRAP_PACKAGE=bubblewrap=0.12.0-r0
# curl CLI (busybox wget is not available); required by install_ci_tools.sh to
# download pinned release binaries (gitleaks for the musl security suite).
ALPINE_CURL_PACKAGE=curl=8.14.1-r4
# ripgrep is required by the boundary scanners (check_companion_server_boundary.sh)
# and the security regression suite on the musl job.
ALPINE_RIPGREP_PACKAGE=ripgrep=14.1.1-r0
