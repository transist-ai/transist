{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transist.dev/schemas/runtime/workflow-asset-snapshot.v1.schema.json",
  "title": "Transist workflow asset snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "transist.workflow_asset_snapshot.v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
